{
  "name": "jamalong",
  "private": true,
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @jamalong/web dev",
    "build": "pnpm --filter @jamalong/web build",
    "test": "pnpm --filter @jamalong/web test",
    "typecheck": "pnpm --filter @jamalong/web typecheck",
    "lint": "biome check",
    "fmt": "biome check --write",
    "check": "pnpm run fmt && pnpm run typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8"
  }
}
